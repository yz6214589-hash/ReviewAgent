# 复制为 .env 后按需修改；密钥仅通过 .env 注入，禁止写入代码或提交仓库。
LLM_BASE_URL=http://internal-gateway/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen2.5-72b-instruct
# 无真实 LLM 凭证时置 true，客户端返回内置流式假数据，保证离线可跑通
LLM_MOCK=true
DATABASE_URL=sqlite:///./data/review.db
CHECKPOINT_DB=./data/checkpoints.db
UPLOAD_DIR=./data/uploads
ARTIFACTS_DIR=./data/artifacts
TEMPLATE_WORD_PATH=./data/templates/blank_score_sheet.docx
# YAML 配置目录（相对 backend/ 或绝对路径）
CONFIG_DIR=../config
